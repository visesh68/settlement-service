# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value below is read from the environment at startup (12-factor); there
# are no secrets baked into the image or the repository.

# ---- required ----
# JDBC URL of the PostgreSQL instance. On Neon/Supabase, take the connection
# string from the dashboard and convert it to JDBC form, keeping sslmode=require:
#   jdbc:postgresql://ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/settlement
DATABASE_USERNAME=settlement
DATABASE_PASSWORD=

# ---- host-provided ----
# Render, Railway, Fly and Koyeb all inject this. Defaults to 8080.
PORT=8080

# ---- optional tuning (defaults shown) ----
# The simulated downstream's injected fault rate. The exercise asks for ~0.4.
MOCK_FAILURE_RATE=0.4
MOCK_MIN_LATENCY=100ms
MOCK_MAX_LATENCY=500ms

# Settlement retry policy.
SETTLEMENT_MAX_ATTEMPTS=10
SETTLEMENT_BACKOFF_BASE=250ms
SETTLEMENT_BACKOFF_MAX=10s
SETTLEMENT_REQUEST_TIMEOUT=3s
# How long a claimed outbox item stays leased before a crashed owner's work is
# reclaimed. Must comfortably exceed SETTLEMENT_REQUEST_TIMEOUT.
SETTLEMENT_LEASE_DURATION=30s
SETTLEMENT_BATCH_SIZE=50
SETTLEMENT_CONCURRENCY=16

# The self-driving drain tick.
DRAIN_TICK_ENABLED=true
DRAIN_TICK_INTERVAL=2s

# Point the drainer at a different provider. Defaults to this app's own
# /mock-settlement; {port} is replaced with the port actually bound.
# SETTLEMENT_DOWNSTREAM_URL=http://127.0.0.1:{port}/mock-settlement

# Distinguishes instances in logs and in outbox lease ownership. Leave unset to
# get a random one per process; two instances must never share a value.
# INSTANCE_ID=

DB_POOL_MAX=24
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# ---- log shipping to Grafana Cloud Loki (optional) ----
# Inert unless the "loki" profile is active, so local runs and tests never try
# to ship anything. stdout JSON logging is unaffected either way.
#   SPRING_PROFILES_ACTIVE=loki
#   LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
#   LOKI_USERNAME=<numeric Grafana Cloud user/instance id>
#   LOKI_PASSWORD=<Grafana Cloud API token with logs:write>
# A shipper cannot report its own failures through the pipeline it cannot reach,
# so set this to see the appender's diagnostics on stdout.
#   LOKI_VERBOSE=false
