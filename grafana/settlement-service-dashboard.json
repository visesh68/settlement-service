{
  "title": "Settlement Service",
  "uid": "settlement-service",
  "tags": ["settlement", "payments", "exactly-once"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Safety — these must never move",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Safety",
      "description": "1 while every safety invariant holds. Drops to 0 the instant one is violated. Alert on this going to 0 AND on the series going stale — a dead scraper must not look like a healthy service.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        { "expr": "settlement_safety_holds", "legendFormat": "safety", "refId": "A" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "VIOLATED", "color": "red", "index": 0 },
                "1": { "text": "HOLDS", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Double-settled payments",
      "description": "Payments the PROVIDER's own ledger shows settled more than once. Asked of the provider rather than our bookkeeping, so it stays honest even if our state is wrong. Any value above 0 means real money moved twice.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        { "expr": "settlement_double_settled", "legendFormat": "double-settled", "refId": "A" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Captured without a settlement job",
      "description": "A payment was captured but no outbox row exists — money owed and never queued. Lost work, not a duplicate.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [
        { "expr": "settlement_captured_without_outbox", "legendFormat": "orphaned captures", "refId": "A" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Settled but never captured",
      "description": "The provider settled something we never captured — a phantom settlement. Money moved for nothing.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [
        { "expr": "settlement_settled_not_captured", "legendFormat": "phantom settlements", "refId": "A" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Effectively-once — delivery vs settlement",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Deliveries vs distinct settlements",
      "description": "The gap between these two lines IS the guarantee. Deliveries climbing above distinct keys means retries happened; the keys line staying flat means none of them settled twice.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        { "expr": "settlement_total_deliveries", "legendFormat": "deliveries", "refId": "A" },
        { "expr": "settlement_distinct_keys", "legendFormat": "distinct settlements", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Deduped retries",
      "description": "Deliveries the provider recognised as duplicates and collapsed. NON-ZERO IS HEALTHY — it is the evidence that at-least-once delivery plus provider dedupe equals effectively-once settlement. Do not alert on this.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [
        { "expr": "settlement_redundant_deliveries", "legendFormat": "deduped retries", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" },
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row",
      "title": "Outbox & throughput",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Outbox depth by status",
      "description": "PENDING and IN_FLIGHT are work still owed. A DEAD_LETTER line above zero is a queue waiting on a human.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "settlement_outbox_size", "legendFormat": "{{status}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "stacking": { "mode": "none" }, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Settlement attempts / successes / retries / dead letters",
      "description": "Per-second rates. Attempts well above successes is the fault injector doing its job, not an incident.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "rate(settlement_attempts_total[5m])", "legendFormat": "attempts", "refId": "A" },
        { "expr": "rate(settlement_success_total[5m])", "legendFormat": "successes", "refId": "B" },
        { "expr": "rate(settlement_retry_total[5m])", "legendFormat": "retries", "refId": "C" },
        { "expr": "rate(settlement_dead_letter_total[5m])", "legendFormat": "dead letters", "refId": "D" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }, "unit": "reqps" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "dead letters" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row",
      "title": "Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Downstream settlement call latency",
      "description": "Real quantiles from a histogram, not inferred from a mean. The simulated provider sleeps 100-500ms by design, so this should sit in that band.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(settlement_call_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(settlement_call_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(settlement_call_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" }, "unit": "s" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "HTTP p99 by endpoint",
      "description": "Server-side request latency. SLO buckets are configured in application.yml.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))", "legendFormat": "{{uri}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }, "unit": "s" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row",
      "title": "Idempotency & crash recovery",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Idempotent replays and key reuse",
      "description": "Replays are clients retrying safely — expected. Key reuse (409) means a caller sent the same key with a different body, which is a client bug worth surfacing.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "targets": [
        { "expr": "rate(idempotency_replay_total[5m])", "legendFormat": "replay ({{scope}})", "refId": "A" },
        { "expr": "rate(idempotency_key_reused_total[5m])", "legendFormat": "key reused (409)", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }, "unit": "reqps" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "key reused (409)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Lease reclaims, lost leases, capture races",
      "description": "The crash-recovery path in the open. Reclaims are stranded in-flight work being rescued after an owner disappeared; lost leases are completions correctly discarded because another drainer had taken over.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "targets": [
        { "expr": "rate(settlement_lease_reclaimed_total[5m])", "legendFormat": "leases reclaimed", "refId": "A" },
        { "expr": "rate(settlement_lease_lost_total[5m])", "legendFormat": "leases lost", "refId": "B" },
        { "expr": "rate(payments_capture_race_lost_total[5m])", "legendFormat": "capture races lost", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }, "unit": "reqps" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Reconciliation gap — settled downstream, not recorded by us",
      "description": "Transiently non-zero mid-drain is normal. PERSISTENTLY non-zero means an instance died after the provider committed but before we recorded it: money moved and our books disagree. This is the one liveness number worth alerting on.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 42 },
      "targets": [
        { "expr": "settlement_settled_downstream_not_recorded", "legendFormat": "unreconciled", "refId": "A" },
        { "expr": "settlement_outstanding", "legendFormat": "still outstanding", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    }
  ]
}
