      "seed": 116146606,
      "version": 1,
      "versionNonce": 1280285447,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "text": "The dangerous window: the provider committed, we died before writing SETTLED.\nThe lease expires, the reaper requeues, and the SAME key is delivered again \u2014\nso the provider dedupes it. Delivery happened twice; settlement happened once.\nThat is the difference between at-least-once delivery and exactly-once effect.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The dangerous window: the provider committed, we died before writing SETTLED.\nThe lease expires, the reaper requeues, and the SAME key is delivered again \u2014\nso the provider dedupes it. Delivery happened twice; settlement happened once.\nThat is the difference between at-least-once delivery and exactly-once effect.",
      "lineHeight": 1.25,
      "autoResize": true
    },
