      "roundness": null,
      "seed": 1982966163,
      "version": 1,
      "versionNonce": 1526706730,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "text": "Reading it:\n\n\u2022 A capture writes the payment\n  and its outbox row in ONE\n  transaction \u2014 never one\n  without the other.\n\n\u2022 The drainer is a scheduled\n  tick, not a request thread.\n  Killing the process loses\n  nothing.\n\n\u2022 The provider is reached over\n  the network on purpose, so\n  timeouts and 5xx are real.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reading it:\n\n\u2022 A capture writes the payment\n  and its outbox row in ONE\n  transaction \u2014 never one\n  without the other.\n\n\u2022 The drainer is a scheduled\n  tick, not a request thread.\n  Killing the process loses\n  nothing.\n\n\u2022 The provider is reached over\n  the network on purpose, so\n  timeouts and 5xx are real.",
      "lineHeight": 1.25,
      "autoResize": true
    }
  ],
  "appState": {
    "gridSize": null,
    "viewBackgroundColor": "#ffffff"
