# Normalise line endings in the repository to LF.
* text=auto eol=lf

# These MUST be LF regardless of platform: a shell script checked out with CRLF
# fails on Linux with "bad interpreter: no such file or directory", which would
# break the correctness gates and CI on a Windows-authored checkout.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# PowerShell is happy either way; CRLF keeps it native on Windows.
*.ps1       text eol=crlf

*.jar       binary
*.png       binary
*.ico       binary
