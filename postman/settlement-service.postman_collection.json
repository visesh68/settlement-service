                  "pm.collectionVariables.set('payment_id', b.id);",
                  "pm.collectionVariables.set('amount', b.amount);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. capture",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"idempotency_key\": \"{{$guid}}\" }" },
            "url": {
              "raw": "{{baseUrl}}/payments/{{payment_id}}/capture",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "{{payment_id}}", "capture"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('settlement_key', b.settlement_key);",
                  "pm.test('CAPTURED', () => pm.expect(b.state).to.eql('CAPTURED'));",
                  "pm.test('settlement key minted once', () => pm.expect(b.settlement_key).to.not.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. drain",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/admin/drain?passes=5",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "drain"],
              "query": [{ "key": "passes", "value": "5" }]
            }
          }
        },
        {
          "name": "5. verify settled",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments/{{payment_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "{{payment_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('SETTLED', () => pm.expect(b.settlement_state).to.eql('SETTLED'));",
                  "pm.test('settled_at is stamped', () => pm.expect(b.timings.settled_at).to.not.be.null);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "B · Idempotent authorize — same key, same body replays",
      "item": [
        {
          "name": "1. authorize with a fixed key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('idem_key', 'scenario-b-' + Date.now());"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('not a replay', () => pm.expect(pm.response.headers.get('Idempotent-Replay')).to.eql('false'));",
                  "pm.collectionVariables.set('payment_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 4200,\n  \"currency\": \"INR\",\n  \"idempotency_key\": \"{{idem_key}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        },
        {
          "name": "2. same key, same body → replays the original response",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 4200,\n  \"currency\": \"INR\",\n  \"idempotency_key\": \"{{idem_key}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
            "description": "Returns the original 201 and the same bytes, with Idempotent-Replay: true. No second payment is created.\n\nThis nameless shape is also the regression guard for the deploy: records written before the `name` column existed must still replay, so a null name contributes no segment to the request fingerprint."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 again', () => pm.response.to.have.status(201));",
                  "pm.test('flagged as a replay', () => pm.expect(pm.response.headers.get('Idempotent-Replay')).to.eql('true'));",
                  "pm.test('same payment, not a new one', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('payment_id')));"
                ]
              }
            }
          ]
        }
      ]
    },
