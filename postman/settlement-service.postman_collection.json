              "raw": "{\n  \"name\": \"Happy path payout\",\n  \"amount\": 125000,\n  \"currency\": \"INR\",\n  \"idempotency_key\": \"{{$guid}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          },
          "event": [
            {
              "listen": "test",
