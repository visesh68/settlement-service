            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"a different label\",\n  \"amount\": 4200,\n  \"currency\": \"INR\",\n  \"idempotency_key\": \"{{idem_key}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
            "description": "The name is part of the canonical request, so changing only the label is still a different request. Everything else is byte-identical."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('name is part of request identity', () => pm.expect(pm.response.json().error).to.eql('idempotency_key_reused'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "D · State machine — double capture and void",
      "item": [
        {
          "name": "1. authorize",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"State machine probe\",\n  \"amount\": 5000,\n  \"currency\": \"INR\",\n  \"idempotency_key\": \"{{$guid}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('payment_id', pm.response.json().id);"]
              }
            }
          ]
        },
        {
          "name": "2. capture → 200",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"idempotency_key\": \"{{$guid}}\" }" },
            "url": {
              "raw": "{{baseUrl}}/payments/{{payment_id}}/capture",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "{{payment_id}}", "capture"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "3. capture again with a NEW key → 409 already captured",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"idempotency_key\": \"{{$guid}}\" }" },
            "url": {
              "raw": "{{baseUrl}}/payments/{{payment_id}}/capture",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "{{payment_id}}", "capture"]
            },
            "description": "A fresh key means this is not a replay — it is a genuine second capture attempt, and the database's WHERE state = 'AUTHORIZED' guard refuses it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('already captured', () => pm.expect(pm.response.json().error).to.eql('already_captured'));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. authorize a second payment, then void it",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"To be voided\",\n  \"amount\": 6000,\n  \"currency\": \"INR\",\n  \"idempotency_key\": \"{{$guid}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('payment_id', pm.response.json().id);"]
              }
            }
          ]
        },
        {
          "name": "5. void → FAILED",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/payments/{{payment_id}}/void",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "{{payment_id}}", "void"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('FAILED', () => pm.expect(pm.response.json().state).to.eql('FAILED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. capture a voided payment → 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"idempotency_key\": \"{{$guid}}\" }" },
            "url": {
              "raw": "{{baseUrl}}/payments/{{payment_id}}/capture",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "{{payment_id}}", "capture"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('invalid transition', () => pm.expect(pm.response.json().error).to.eql('invalid_state_transition'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "E · Deduped retries — provider idempotency in the open",
      "item": [
        {
          "name": "1. pin fault rate to 0.0",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"failure_rate\": 0.0 }" },
            "url": {
              "raw": "{{baseUrl}}/admin/mock-settlement/config",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "mock-settlement", "config"]
            },
            "description": "Isolate the effect. A 500 records nothing downstream, so ordinary retry-after-failure never produces a duplicate delivery — which is exactly why this counter normally sits at 0."
          }
        },
        {
          "name": "2. authorize",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dedupe demo\",\n  \"amount\": 125000,\n  \"currency\": \"INR\",\n  \"idempotency_key\": \"{{$guid}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('payment_id', b.id);",
                  "pm.collectionVariables.set('amount', b.amount);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. capture",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"idempotency_key\": \"{{$guid}}\" }" },
            "url": {
              "raw": "{{baseUrl}}/payments/{{payment_id}}/capture",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "{{payment_id}}", "capture"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('settlement_key', pm.response.json().settlement_key);"]
              }
            }
          ]
        },
        {
          "name": "4. drain until settled",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/admin/drain?passes=5",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "drain"],
              "query": [{ "key": "passes", "value": "5" }]
            }
          }
        },
        {
          "name": "5. record the BEFORE counters",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/stats", "host": ["{{baseUrl}}"], "path": ["admin", "stats"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().downstream;",
                  "pm.collectionVariables.set('deduped_before', d.redundant_deliveries);",
                  "console.log('deduped retries BEFORE = ' + d.redundant_deliveries);"
                ]
              }
            }
          ]
        },
        {
          "name": "6. REDELIVER the same settlement key",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settlement_key\": \"{{settlement_key}}\",\n  \"payment_id\": \"{{payment_id}}\",\n  \"amount_minor\": {{amount}},\n  \"currency\": \"INR\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/mock-settlement", "host": ["{{baseUrl}}"], "path": ["mock-settlement"] },
            "description": "Exactly what a crashed instance or a post-commit timeout does: deliver a key the provider already settled. Note this body carries NO name — the response still echoes the name stored at first settlement, because the original settlement is what stands."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK — never an error', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('recognised as a duplicate', () => pm.expect(b.duplicate).to.be.true);",
                  "pm.test('delivered more than once', () => pm.expect(b.delivery_count).to.be.above(1));",
                  "pm.test('original name echoed back, not the absent one', () => pm.expect(b.name).to.eql('Dedupe demo'));",
                  "console.log('delivery_count = ' + b.delivery_count + ', provider_ref = ' + b.provider_ref);"
                ]
              }
            }
          ]
        },
        {
          "name": "7. deduped retries went UP, double-settled did NOT",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/stats", "host": ["{{baseUrl}}"], "path": ["admin", "stats"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = pm.response.json();",
                  "const before = Number(pm.collectionVariables.get('deduped_before'));",
                  "const after = s.downstream.redundant_deliveries;",
                  "console.log('deduped retries AFTER = ' + after + ' (was ' + before + ')');",
                  "pm.test('deduped retries increased', () => pm.expect(after).to.be.above(before));",
                  "pm.test('deliveries exceed distinct settlement keys', () => pm.expect(s.downstream.total_deliveries).to.be.above(s.downstream.distinct_settlement_keys));",
                  "pm.test('STILL no payment settled twice', () => pm.expect(s.invariants.double_settled_payments).to.eql(0));",
                  "pm.test('safety still holds', () => pm.expect(s.invariants.safety_holds).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "F · Dead-lettering — terminal failure is visible, not dropped",
      "item": [
        {
          "name": "1. force the downstream to fail every time",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"failure_rate\": 1.0 }" },
            "url": {
              "raw": "{{baseUrl}}/admin/mock-settlement/config",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "mock-settlement", "config"]
            },
            "description": "NOTE: with the default SETTLEMENT_MAX_ATTEMPTS=10 and exponential backoff (250ms → 10s), exhausting attempts takes well over a minute of repeated draining. For a fast demo restart with SETTLEMENT_MAX_ATTEMPTS=2."
          }
        },
        {
          "name": "2. authorize + capture",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Doomed settlement\",\n  \"amount\": 999,\n  \"currency\": \"INR\",\n  \"idempotency_key\": \"{{$guid}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('payment_id', pm.response.json().id);"]
              }
            }
          ]
        },
        {
          "name": "3. capture",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"idempotency_key\": \"{{$guid}}\" }" },
            "url": {
              "raw": "{{baseUrl}}/payments/{{payment_id}}/capture",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "{{payment_id}}", "capture"]
            }
          }
        },
        {
          "name": "4. drain repeatedly (re-send until attempts exhaust)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/admin/drain?passes=50",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "drain"],
              "query": [{ "key": "passes", "value": "50" }]
            }
          }
        },
        {
          "name": "5. it is in the dead-letter queue, not lost",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/dead-letters?limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "dead-letters"],
              "query": [{ "key": "limit", "value": "100" }]
            },
            "description": "Nothing is silently dropped. Each entry carries last_error, attempts, and now the settlement name."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "console.log('dead letters: ' + pm.response.json().length);"
                ]
              }
            }
          ]
        },
        {
          "name": "6. restore the fault rate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"failure_rate\": 0.4 }" },
            "url": {
              "raw": "{{baseUrl}}/admin/mock-settlement/config",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "mock-settlement", "config"]
            }
          }
        }
      ]
    },
    {
      "name": "G · Settlement name — end to end",
      "item": [
        {
          "name": "0. pin fault rate to 0.0",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"failure_rate\": 0.0 }" },
            "url": {
              "raw": "{{baseUrl}}/admin/mock-settlement/config",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "mock-settlement", "config"]
            },
            "description": "Step 5 needs the settlement to have actually landed, so the fault rate must be pinned here rather than inherited from whatever a previous folder left behind."
          }
        },
        {
          "name": "1. authorize with a name",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Umbrella Q3 settlement\",\n  \"amount\": 125000,\n  \"currency\": \"INR\",\n  \"idempotency_key\": \"{{$guid}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('payment_id', b.id);",
                  "pm.collectionVariables.set('amount', b.amount);",
                  "pm.test('name round-trips', () => pm.expect(b.name).to.eql('Umbrella Q3 settlement'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. a name over 120 chars is rejected at the edge",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",\n  \"amount\": 100,\n  \"currency\": \"INR\",\n  \"idempotency_key\": \"{{$guid}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
            "description": "121 characters. Rejected by bean validation before any money logic runs — not by a database constraint violation surfacing as a 500."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('not a 500', () => pm.expect(pm.response.code).to.not.eql(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. capture",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"idempotency_key\": \"{{$guid}}\" }" },
            "url": {
              "raw": "{{baseUrl}}/payments/{{payment_id}}/capture",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "{{payment_id}}", "capture"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('settlement_key', pm.response.json().settlement_key);"]
              }
            }
          ]
        },
        {
          "name": "4. drain",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/admin/drain?passes=5",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "drain"],
              "query": [{ "key": "passes", "value": "5" }]
            }
          }
        },
        {
          "name": "5. prove the name reached the provider's own ledger",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settlement_key\": \"{{settlement_key}}\",\n  \"payment_id\": \"{{payment_id}}\",\n  \"amount_minor\": {{amount}},\n  \"currency\": \"INR\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/mock-settlement", "host": ["{{baseUrl}}"], "path": ["mock-settlement"] },
            "description": "This body carries NO name. If the response still returns one, it can only have come from the row the provider stored — which is the proof the name survived the network hop rather than being read back out of our own tables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('duplicate delivery', () => pm.expect(b.duplicate).to.be.true);",
                  "pm.test('name came from the provider ledger', () => pm.expect(b.name).to.eql('Umbrella Q3 settlement'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
