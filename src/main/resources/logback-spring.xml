<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured logging.

  Production (default): one JSON object per line on stdout, which is what the
  hosted log backend ingests. Every line carries the MDC, which always holds a
  correlation_id — for HTTP requests it comes from the inbound header or is
  minted by CorrelationIdFilter; for settlement work it is the correlation id
  captured on the outbox row at capture time, so settlement retries and
  dead-letters correlate back to the request that created them.

  Local dev / tests get human-readable output via src/test/resources/logback-test.xml.

  Nothing sensitive is logged: no idempotency key values, no credentials, no
  request bodies. Only ids, states, counts and timings.
-->
<configuration>
  <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="settlement-service"/>

  <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <timeZone>UTC</timeZone>
      <fieldNames>
        <timestamp>ts</timestamp>
        <version>[ignore]</version>
        <levelValue>[ignore]</levelValue>
        <thread>thread</thread>
        <logger>logger</logger>
        <message>msg</message>
      </fieldNames>
      <customFields>{"service":"${appName}"}</customFields>
      <includeContext>false</includeContext>
      <includeMdcKeyName>correlation_id</includeMdcKeyName>
      <includeMdcKeyName>instance_id</includeMdcKeyName>
      <includeMdcKeyName>payment_id</includeMdcKeyName>
      <includeMdcKeyName>settlement_key</includeMdcKeyName>
      <includeMdcKeyName>outbox_id</includeMdcKeyName>
      <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
        <maxDepthPerThrowable>25</maxDepthPerThrowable>
        <maxLength>4096</maxLength>
        <rootCauseFirst>true</rootCauseFirst>
      </throwableConverter>
    </encoder>
  </appender>

  <!--
    Ship the same JSON to Grafana Cloud Loki.

    Active only under the "loki" Spring profile, so an unset LOKI_URL can never
    half-configure an appender that then fails at startup: no profile, no
    appender. Enable with SPRING_PROFILES_ACTIVE=loki plus the three LOKI_*
    variables.

    The message layout is deliberately the same LogstashLayout as stdout, so a
    Grafana query can `| json` the line and get correlation_id, payment_id and
    settlement_key as real fields rather than having to regex them out of a
    formatted string.

    Labels are kept to a tiny, low-cardinality set. Loki indexes labels, so
    putting payment_id or correlation_id in there would create a stream per
    payment and fall over; those belong in the log line, which is exactly where
    the JSON layout puts them.
  -->
  <springProfile name="loki">
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
      <http>
        <url>${LOKI_URL}</url>
        <auth>
          <username>${LOKI_USERNAME}</username>
          <password>${LOKI_PASSWORD}</password>
        </auth>
        <useProtobufApi>false</useProtobufApi>
        <requestTimeoutMs>15000</requestTimeoutMs>
      </http>
      <labels>
        service = ${appName}
        level = %level
      </labels>
      <structuredMetadata>off</structuredMetadata>
      <message class="net.logstash.logback.layout.LogstashLayout">
        <timeZone>UTC</timeZone>
        <includeContext>false</includeContext>
        <customFields>{"service":"${appName}"}</customFields>
        <fieldNames>
          <timestamp>ts</timestamp>
          <version>[ignore]</version>
          <levelValue>[ignore]</levelValue>
          <message>msg</message>
        </fieldNames>
      </message>
      <batch>
        <maxItems>200</maxItems>
        <timeoutMs>5000</timeoutMs>
      </batch>
      <!-- LOKI_VERBOSE=true prints the appender's own diagnostics, which is the
           only way to see why a push is failing: a log shipper cannot report its
           own failures through the log pipeline it is failing to reach. -->
      <verbose>${LOKI_VERBOSE:-false}</verbose>
    </appender>
  </springProfile>

  <!--
    Two profile-scoped roots rather than one root with a conditional
    appender-ref: logback rejects <springProfile> nested inside <root>, and does
    so with a warning it then ignores, so the appender silently never attaches.

    stdout is in both: the platform's own log view must never depend on a
    third-party backend being reachable.
  -->
  <springProfile name="!loki">
    <root level="INFO">
      <appender-ref ref="JSON"/>
    </root>
  </springProfile>

  <springProfile name="loki">
    <root level="INFO">
      <appender-ref ref="JSON"/>
      <appender-ref ref="LOKI"/>
    </root>
  </springProfile>
</configuration>
